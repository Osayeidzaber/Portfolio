npx create-next-app@latest osayeed-portfolio --typescript --tailwind --eslint
cd osayeed-portfolio
npm install framer-motion three @react-three/fiber @react-three/drei gsap particles.js

# Install dependencies
npm install sharp @next/bundle-analyzer

# Install type definitions for node
npm install --save-dev @types/node

# Remove node_modules and package-lock.json
rm -rf node_modules package-lock.json

# Clean npm cache
npm cache clean --force

# Reinstall dependencies
npm install

# Run the development server
npm run dev

